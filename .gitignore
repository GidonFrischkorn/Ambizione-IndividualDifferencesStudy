# ignore all node_modules & jspsych-builder directories
**/node_modules/
**/.jspsych-builder
**/packaged/

# ignore all package-lock.json files
**/package-lock

# file-types to ignore
**.zip
**.DS_Store
**.history
__pycache__/
**.vscode/
**.log
**.jspsych-builder/
~$*
**.tmp

# Word temporary
~$**.doc*

# Excel temporary
~$**.xls*

# PowerPoint temporary
~$**.ppt*



# local-only material (exports, rigor logs); never committed
local/
